{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests", "-q"],
  "[python]": { "editor.defaultFormatter": "charliermarsh.ruff", "editor.rulers": [120] },
  "files.exclude": { "**/__pycache__": true, "**/.pytest_cache": true, "**/.ruff_cache": true, "*.egg-info": true },
  "search.exclude": { ".venv": true, "results": true, "data": true }
}
